{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "affiliate-report-pairing-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "aff-report.huuhungn.io.vn",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAIRING_SESSIONS",
        "class_name": "PairingSession"
      }
    ]
  },
  "exports": {
    "PairingSession": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "r2_buckets": [
    {
      "binding": "PAIRING_FILES",
      "bucket_name": "affiliate-report-pairing-temp"
    }
  ],
  "ratelimits": [
    {
      "name": "SESSION_CREATION_RATE_LIMITER",
      "namespace_id": "20701",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "SERVICE_VERSION": "1.0.0",
    "MAX_PLAINTEXT_BYTES": "20971520",
    "MAX_ENCRYPTED_BYTES": "20975616",
    "SESSION_TTL_SECONDS": "300",
    "HARD_TTL_SECONDS": "900"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
